{
  "name": "icanboogie/http",
  "type": "library",
  "version": "6.0",
  "description": "Provides an API to handle HTTP requests.",
  "keywords": [
    "http",
    "dispatcher",
    "request",
    "response"
  ],
  "homepage": "https://icanboogie.org/",
  "license": "BSD-3-Clause",
  "authors": [
    {
      "name": "Olivier Laviale",
      "email": "olivier.laviale@gmail.com",
      "homepage": "https://olvlvl.com/",
      "role": "Developer"
    }
  ],
  "support": {
    "issues": "https://github.com/ICanBoogie/HTTP/issues",
    "source": "https://github.com/ICanBoogie/HTTP"
  },
  "config": {
    "sort-packages": true
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "require": {
    "php": ">=8.2",
    "ext-mbstring": "*",
    "icanboogie/prototype": "^6.0",
    "icanboogie/event": "^6.0"
  },
  "require-dev": {
    "ext-fileinfo": "*",
    "ext-gd": "*",
    "icanboogie/datetime": "^3.0",
    "phpstan/phpstan": "^1.12",
    "phpunit/phpunit": "^11.4"
  },
  "autoload": {
    "psr-4": {
      "ICanBoogie\\HTTP\\": "lib/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Test\\ICanBoogie\\HTTP\\": "tests"
    }
  }
}
